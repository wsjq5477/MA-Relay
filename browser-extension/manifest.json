{
  "manifest_version": 3,
  "name": "AgentBridge Browser Agent",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Receive authorized AgentBridge tasks in explicitly enabled browser sessions.",
  "permissions": ["storage", "alarms", "scripting"],
  "optional_host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "src/background/index.mjs", "type": "module"},
  "action": {"default_title": "AgentBridge Browser Agent"},
  "options_ui": {"page": "src/options/index.html", "open_in_tab": true},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"}
}
